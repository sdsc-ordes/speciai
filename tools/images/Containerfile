# Review web server image: `speciai serve` on port 8000.
FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# README.md is referenced by pyproject and required to build the package.
COPY README.md pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --locked --no-dev

EXPOSE 8000
# 0.0.0.0: the CLI default 127.0.0.1 is unreachable from outside the container.
# `serve` reads LLM_BASE_URL / LLM_MODEL / LLM_THINKING from the environment itself.
CMD ["uv", "run", "--no-sync", "speciai", "serve", "--host", "0.0.0.0", "--port", "8000"]
