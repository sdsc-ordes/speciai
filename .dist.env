# This key is used to decrypt all secrets in the repository. Keep it encrypted.
SOPS_AGE_KEY_FILE=

# OpenAI-compatible endpoint serving a multimodal model. Every command that reads a
# photo takes these; a flag (--llm-base-url, --model, --thinking) overrides them.
# See the provider table in README.md.
# LLM_BASE_URL defaults to EPFL's RCP inference service when unset.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Empty means "off": no reasoning trace, which is how the benchmarks were scored.
# "on" enables it on a vLLM-hosted model. "none" sends no such field at all, for a
# provider that rejects one it does not define (OpenAI, Gemini).
LLM_THINKING=
# Empty means 0.0, which keeps a run reproducible. "none" omits the parameter
# entirely, which the Claude models require.
LLM_TEMPERATURE=
